@@ -15,9 +15,20 @@
 // with this program; if not, write to the Free Software Foundation, Inc.,
 // 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
 
+#import <TargetConditionals.h>
+#if TARGET_OS_IPHONE
+#import <UIKit/UIKit.h>
+#else
 #import <Cocoa/Cocoa.h>
+#endif
 #import <QuartzCore/CAMetalLayer.h>
 
-extern "C" void *get_metal_layer_from_view(void *nsview) {
-    return (__bridge void *)((__bridge NSView *)nsview).layer;
+extern "C" void *get_metal_layer_from_view(void *view) {
+#if TARGET_OS_IPHONE
+    // iOS: SDL3's Metal window surfaces expose a UIView whose backing layer
+    // is a CAMetalLayer, exactly like the NSView case on macOS.
+    return (__bridge void *)((__bridge UIView *)view).layer;
+#else
+    return (__bridge void *)((__bridge NSView *)view).layer;
+#endif
 }
