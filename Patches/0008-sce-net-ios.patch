@@ -353,6 +353,19 @@ EXPORT(int, sceNetGetMacAddress, SceNetEtherAddr *addr, int flags) {
 
     if (!get_mac_address(hint, addr->data))
         RET_NET_ERRNO(SCE_NET_ERROR_EINVAL);
+#elif defined(__IPHONEOS__)
+    // iOS has no SystemConfiguration-based helper (SCDynamicStore is
+    // macOS-only) and no usable interface MAC; report a deterministic
+    // locally administered address instead.
+    const uint8_t magic_mac[6] = {
+        0x02, // LAA
+        0x49, // 'I'
+        0x4F, // 'O'
+        0x53, // 'S'
+        0x56, // 'V'
+        0x49, // 'I'
+    };
+    memcpy(addr->data, magic_mac, sizeof(addr->data));
 #else
     return UNIMPLEMENTED();
 #endif