@@ -313,7 +313,7 @@ EXPORT(int, sceNetGetMacAddress, SceNetEtherAddr *addr, int flags) {
         }
     }
     RET_NET_ERRNO(SCE_NET_ERROR_EINVAL);
-#elif defined(__unix__)
+#elif defined(__unix__) && !defined(__IPHONEOS__)
     struct ifreq ifr{};
 
     int sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_IP);
@@ -345,7 +345,7 @@ EXPORT(int, sceNetGetMacAddress, SceNetEtherAddr *addr, int flags) {
     if (ioctl(sock, SIOCGIFHWADDR, &ifr) == -1)
         RET_NET_ERRNO(SCE_NET_ERROR_EINVAL);
     memcpy(addr->data, ifr.ifr_hwaddr.sa_data, 6);
-#elif defined(__APPLE__)
