diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index 794f836..edbd8ad 100644
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -36,6 +36,13 @@ set(CMAKE_FOLDER externals)
 
 option(BUILD_SHARED_LIBS "Build shared library" OFF)
 option(CAPSTONE_ARCHITECTURE_DEFAULT "Whether architectures are enabled by default" OFF)
 option(CAPSTONE_ARM_SUPPORT "ARM support" ON)
+# Capstone overrides CMAKE_OSX_ARCHITECTURES to a universal "x86_64;arm64"
+# list on Apple, which the iOS SDK cannot build (no x86_64 slice). Its
+# CAPSTONE_BUILD_MACOS_THIN option skips that override and keeps the parent
+# arm64-only setting.
+if(IOS)
+	set(CAPSTONE_BUILD_MACOS_THIN ON CACHE BOOL "Build capstone for a single architecture" FORCE)
+endif()
 add_subdirectory(capstone EXCLUDE_FROM_ALL)
 
 add_library(dirent INTERFACE)
@@ -83,6 +90,9 @@ target_include_directories(miniz PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/miniz")
 add_subdirectory(sdl)
 
 # Cubeb setup, from https://github.com/RPCS3/rpcs3/blob/master/3rdparty/cubeb/CMakeLists.txt
+# Cubeb is skipped on iOS: its CoreAudio backend is not guaranteed to build
+# there, and the SDL audio backend is the default anyway.
+if(NOT IOS)
 set(BUILD_SHARED_LIBS FALSE CACHE BOOL "Don't build shared libs")
 set(BUILD_TESTS FALSE CACHE BOOL "Don't build tests")
 set(BUILD_RUST_LIBS FALSE CACHE BOOL "Don't build rust libs")
@@ -103,6 +113,7 @@ elseif (ARCHITECTURE STREQUAL "x86_64")
 		_USE_SSE2
 	)
 endif ()
+endif()
 
 if(ANDROID)
 	if(ARCHITECTURE STREQUAL "arm64")
@@ -224,7 +235,7 @@ target_include_directories(CLI11 INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/cli11")
 
 add_library(vulkan INTERFACE)
 target_include_directories(vulkan INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/VulkanMemoryAllocator-Hpp/Vulkan-Headers/include")
-if(APPLE)
+if(APPLE AND NOT IOS)
 	if(NOT EXISTS "${CMAKE_BINARY_DIR}/external/MoltenVK-macos.tar")
 		message(STATUS "Downloading MoltenVK...")
 		file(DOWNLOAD https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.1/MoltenVK-macos.tar
@@ -238,6 +249,24 @@ if(APPLE)
 	endif()
 	target_include_directories(vulkan INTERFACE "${CMAKE_BINARY_DIR}/external/MoltenVK/include")
 	set(MOLTENVK_DYLIB "${CMAKE_BINARY_DIR}/external/MoltenVK/dylib/macOS/libMoltenVK.dylib" PARENT_SCOPE)
+elseif(IOS)
+	# iOS has no native Vulkan driver: MoltenVK translates the Vulkan API to
+	# Metal, which is the only GPU API available on iOS. This is the same
+	# approach Vita3K uses on macOS. The iOS release ships only a static
+	# xcframework (device arm64), so MOLTENVK_DYLIB points at libMoltenVK.a.
+	if(NOT EXISTS "${CMAKE_BINARY_DIR}/external/MoltenVK-ios.tar")
+		message(STATUS "Downloading MoltenVK for iOS...")
+		file(DOWNLOAD https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.2/MoltenVK-ios.tar
+			"${CMAKE_BINARY_DIR}/external/MoltenVK-ios.tar"
+			SHOW_PROGRESS
+			EXPECTED_HASH SHA256=b5d947b1660e6e9fed40b9cd2387e160aaab9e80b775c0cef7e14059405178c1)
+	endif()
+	if(NOT EXISTS "${CMAKE_BINARY_DIR}/external/MoltenVK")
+		execute_process(COMMAND tar xf "${CMAKE_BINARY_DIR}/external/MoltenVK-ios.tar" --strip-components=1 MoltenVK/MoltenVK
+			WORKING_DIRECTORY "${CMAKE_BINARY_DIR}/external")
+	endif()
+	target_include_directories(vulkan INTERFACE "${CMAKE_BINARY_DIR}/external/MoltenVK/include")
+	set(MOLTENVK_DYLIB "${CMAKE_BINARY_DIR}/external/MoltenVK/static/MoltenVK.xcframework/ios-arm64/libMoltenVK.a" PARENT_SCOPE)
 elseif(ANDROID AND NOT (CMAKE_BUILD_TYPE STREQUAL "Release"))
 	# add validation layer
 	if (NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/../android/prebuilt/${ANDROID_ABI}/libVkLayer_khronos_validation.so")
@@ -272,7 +301,7 @@ if(ANDROID)
 endif()
 add_subdirectory(ffmpeg)
 
-if(APPLE OR NOT FORCE_BUILD_OPENSSL_MAC)
+if((APPLE AND NOT IOS) OR NOT FORCE_BUILD_OPENSSL_MAC)
 	execute_process(
 		COMMAND brew --prefix openssl
 		RESULT_VARIABLE BREW_RESULT
@@ -285,7 +314,7 @@ if(APPLE OR NOT FORCE_BUILD_OPENSSL_MAC)
 	endif()
 endif()
 
-if(NOT FORCE_BUILD_OPENSSL_MAC)
+if((NOT FORCE_BUILD_OPENSSL_MAC) AND NOT IOS)
 	find_package(OpenSSL QUIET)
 endif()
 
@@ -326,7 +355,14 @@ if(NOT OPENSSL_FOUND OR FORCE_BUILD_OPENSSL_MAC)
 
 		if (NOT EXISTS "${CMAKE_BINARY_DIR}/external/openssl/libssl.a" OR NOT EXISTS "${CMAKE_BINARY_DIR}/external/openssl/libcrypto.a")
 			message(STATUS "Building OpenSSL@4...")
-			if (ARCHITECTURE STREQUAL "x86_64" OR ARCHITECTURE STREQUAL "arm64")
+			if (IOS)
+				execute_process(COMMAND perl Configure darwin64-arm64 no-shared no-tests -isysroot ${CMAKE_OSX_SYSROOT} -miphoneos-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET} WORKING_DIRECTORY "${CMAKE_BINARY_DIR}/external/openssl")
+				execute_process(COMMAND make -j${CPU_COUNT} WORKING_DIRECTORY "${CMAKE_BINARY_DIR}/external/openssl")
+				# FindOpenSSL looks for libssl.a/libcrypto.a under ${ROOT}/lib, but
+				# OpenSSL's make drops them at the source root. Mirror them.
+				file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/external/openssl/lib")
+				file(COPY "${CMAKE_BINARY_DIR}/external/openssl/libssl.a" "${CMAKE_BINARY_DIR}/external/openssl/libcrypto.a" DESTINATION "${CMAKE_BINARY_DIR}/external/openssl/lib")
+			elseif (ARCHITECTURE STREQUAL "x86_64" OR ARCHITECTURE STREQUAL "arm64")
 				execute_process(COMMAND perl Configure darwin64-${ARCHITECTURE} -mmacosx-version-min=11 WORKING_DIRECTORY "${CMAKE_BINARY_DIR}/external/openssl")
 				execute_process(COMMAND make -j${CPU_COUNT} WORKING_DIRECTORY "${CMAKE_BINARY_DIR}/external/openssl" OUTPUT_QUIET)
 			else()
@@ -347,7 +383,13 @@ if(NOT OPENSSL_FOUND OR FORCE_BUILD_OPENSSL_MAC)
 
 		set(OPENSSL_ROOT_DIR "${CMAKE_BINARY_DIR}/external/openssl")
 		set(OPENSSL_USE_STATIC_LIBS TRUE)
+		# Provide the paths explicitly: FindOpenSSL's own search does not
+		# reliably pick up a freshly cross-compiled tree, so skip it.
+		set(OPENSSL_INCLUDE_DIR "${CMAKE_BINARY_DIR}/external/openssl/include" CACHE FILEPATH "OpenSSL include dir" FORCE)
+		set(OPENSSL_SSL_LIBRARY "${CMAKE_BINARY_DIR}/external/openssl/lib/libssl.a" CACHE FILEPATH "OpenSSL ssl library" FORCE)
+		set(OPENSSL_CRYPTO_LIBRARY "${CMAKE_BINARY_DIR}/external/openssl/lib/libcrypto.a" CACHE FILEPATH "OpenSSL crypto library" FORCE)
+		set(OPENSSL_LIBRARIES "${OPENSSL_SSL_LIBRARY};${OPENSSL_CRYPTO_LIBRARY}" CACHE STRING "OpenSSL libraries" FORCE)
+		set(OPENSSL_FOUND TRUE CACHE BOOL "OpenSSL found" FORCE)
 	endif()
 	find_package(OpenSSL REQUIRED)
 endif()
@@ -464,7 +507,9 @@ endif()
 # Use XDG desktop portals on Linux
 set(NFD_PORTAL ON)
 
-if(NOT ANDROID)
+# nativefiledialog-extended is a desktop file dialog: it links AppKit on
+# Apple platforms, which does not exist on iOS. Skip it there.
+if(NOT ANDROID AND NOT IOS)
 	# nativefiledialog-extended
 	add_subdirectory(nativefiledialog-extended)
 
