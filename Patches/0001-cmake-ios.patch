diff --git a/CMakeLists.txt b/CMakeLists.txt
index d9edf97..adbd762 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -19,7 +19,13 @@ include("external/dynarmic/CMakeModules/DetectArchitecture.cmake")
 set(CMAKE_CXX_STANDARD 23)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
-set(CMAKE_OSX_DEPLOYMENT_TARGET 13.3)
+# iOS requires at least 14.0 for std::atomic wait/notify and we target 15.0
+# (matches the minimum of the pinned MoltenVK static library).
+if(IOS)
+	set(CMAKE_OSX_DEPLOYMENT_TARGET 15.0)
+else()
+	set(CMAKE_OSX_DEPLOYMENT_TARGET 13.3)
+endif()
 
 # workaround for SDL due to cmake bug
 # https://github.com/libsdl-org/SDL/issues/6454
@@ -45,7 +51,7 @@ if(ANDROID)
 		set(CMAKE_VISIBILITY_INLINES_HIDDEN 1)
 	endif()
 else()
-	if((ARCHITECTURE STREQUAL "x86_64") OR APPLE)
+	if(((ARCHITECTURE STREQUAL "x86_64") OR APPLE) AND NOT IOS)
 		option(USE_DISCORD_RICH_PRESENCE "Build Vita3K with Discord Rich Presence" ON)
 	endif()
 	option(BUILD_APPIMAGE "Build an AppImage." OFF)
@@ -149,6 +155,54 @@ macro(boost_compile)
 			WORKING_DIRECTORY ${BOOST_SOURCEDIR}
 			OUTPUT_QUIET
 		)
+	elseif(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+		file(MAKE_DIRECTORY "${BOOST_INSTALLDIR}")
+		execute_process(
+			COMMAND ${b2_cmd_line_common} target-os=iphone architecture=arm address-model=64
+				cxxflags="-arch arm64 -isysroot ${CMAKE_OSX_SYSROOT} -miphoneos-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}"
+				linkflags="-arch arm64 -isysroot ${CMAKE_OSX_SYSROOT} -miphoneos-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}" stage
+			WORKING_DIRECTORY ${BOOST_SOURCEDIR}
+			OUTPUT_FILE "${BOOST_INSTALLDIR}/b2-stage.log"
+			ERROR_FILE "${BOOST_INSTALLDIR}/b2-stage.log"
+			RESULT_VARIABLE BOOST_STAGE_RESULT
+		)
+		if(NOT BOOST_STAGE_RESULT EQUAL 0)
+			file(READ "${BOOST_INSTALLDIR}/b2-stage.log" BOOST_STAGE_LOG)
+			message(FATAL_ERROR "Boost b2 stage failed (exit ${BOOST_STAGE_RESULT})\n${BOOST_STAGE_LOG}")
+		endif()
+		# Boost.Filesystem has been header-only since Boost 1.84, so b2 stage
+		# produces no libboost_filesystem.a (only CMake package files). Require
+		# the CMake package file as the artifact check instead.
+		if(NOT EXISTS "${BOOST_INSTALLDIR}/lib/cmake/Boost-1.89.0/BoostConfig.cmake")
+			file(READ "${BOOST_INSTALLDIR}/b2-stage.log" BOOST_STAGE_LOG)
+			message(FATAL_ERROR "Boost stage did not produce its CMake package files\n${BOOST_STAGE_LOG}")
+		endif()
+		# CMake >= 3.30 removed the FindBoost module, so the config-mode
+		# find_package(Boost) below needs a BoostConfig.cmake. ext-boost does
+		# not ship one, so write it by hand pointing at the staged library.
+		file(WRITE "${BOOST_INSTALLDIR}/BoostConfig.cmake"
+			"set(Boost_VERSION 1.89.0)\n"
+			"set(Boost_VERSION_STRING \"1.89.0\")\n"
+			"set(Boost_FOUND TRUE)\n"
+			"set(Boost_INCLUDE_DIRS \"${BOOST_SOURCEDIR}\")\n"
+			"set(Boost_LIBRARY_DIRS \"${BOOST_INSTALLDIR}/lib\")\n"
+			# Boost.Filesystem is header-only in 1.89: link nothing.
+			"set(Boost_LIBRARIES \"\")\n"
+			"set(Boost_filesystem_FOUND TRUE)\n"
+		)
+		file(WRITE "${BOOST_INSTALLDIR}/BoostConfigVersion.cmake"
+			"set(PACKAGE_VERSION \"1.89.0\")\n"
+			"if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)\n"
+			"  set(PACKAGE_VERSION_COMPATIBLE FALSE)\n"
+			"else()\n"
+			"  set(PACKAGE_VERSION_COMPATIBLE TRUE)\n"
+			"  if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)\n"
+			"    set(PACKAGE_VERSION_EXACT TRUE)\n"
+			"  endif()\n"
+			"endif()\n"
+		)
+		# Point config-mode find_package(Boost) straight at our config file.
+		set(Boost_DIR "${BOOST_INSTALLDIR}")
 	elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 		execute_process(
 			COMMAND ${b2_cmd_line_common} --ignore-site-config toolset=${BOOST_TOOLSET} stage
